.title-text {
    font-size: 20px;
    color: rgb(255, 255, 255);
    text-shadow: 2px 2px 0 rgb(63, 63, 63);
    -unity-text-align: upper-center;
}

.sub-title-text {
    margin-bottom: 5px;
    font-size: 14px;
}

.sub-container {
    flex-grow: 0;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    margin-top: 5px;
    margin-bottom: 5px;
}

.menu-box {
    flex-grow: 0;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    background-color: rgb(109, 108, 114);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
}

.btn {
    padding-top: 6px;
    padding-bottom: 6px;
    padding-right: 10px;
    padding-left: 10px;
    margin-top: 5px;
    margin-bottom: 5px;
}

.loding-screen {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(71, 71, 71, 0.75);
    visibility: hidden;
}

.loding-screen.on {
    visibility: visible;
}

.toast-container {
    flex-grow: 1;
    position: absolute;
    bottom: 0;
    width: 100%;
    align-items: center;
    padding-bottom: 20px;
}

.toast {
    flex-grow: 1;
    background-color: rgb(66, 83, 197);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    padding-right: 10px;
    padding-left: 10px;
    padding-top: 5px;
    padding-bottom: 5px;
    transform-origin: bottom;
    translate: 0 200%;
    transition-duration: 0.3s;
}

.toast.on {
    transform-origin: bottom;
    translate: 0 0%;
}

.popup {
    position: absolute;
    justify-content: flex-start;
    align-items: stretch;
    align-self: center;
    align-content: flex-start;
    flex-direction: column;
    -unity-text-align: upper-left;
    flex-wrap: nowrap;
    top: 50%;
    visibility: hidden;
}

.popup.on {
    visibility: visible;
}
